# Colowo settings. Copy to .env.local only if you need to change something —
# `npm run dev` works with no settings at all (it runs its own local database).

# Use your own Postgres instead of the built-in one (e.g. Neon's pooled connection string).
# Leave unset for local testing. REQUIRED in production (Vercel).
# DATABASE_URL=postgres://user:password@your-host/colowo

# Required in production: 32+ random characters (openssl rand -base64 48).
# Generated automatically for local development.
# SESSION_SECRET=

# Prefix for system-generated member numbers, e.g. CLW00001 [CONFIRM format with the cooperative]
MEMBER_NO_PREFIX=CLW
